    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "<b>Decals</b> are GameObjects that allow you to project a Decal Material onto other surfaces. \n\nThey are mostly used to add texture details without the use of additional meshes and to reduce the repetition of tiling textures."
