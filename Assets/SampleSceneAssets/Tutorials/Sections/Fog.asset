  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this tutorial, you learned how the Global Fog in Unity can be tuned. \n\nFor more information about fog, you can check out this <a href=\"https://youtu.be/yqCHiZrgKzs?t=3053\">video</a> or the related <a href=\"https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@latest/index.html?subfolder=/manual/fog-volume-override-reference.html\">documentation.</a>\n\n<b>Note:</b> You do not need to save your changes in order to follow other tutorials."
