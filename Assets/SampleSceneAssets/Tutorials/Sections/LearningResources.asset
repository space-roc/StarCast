    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "For more information on HDRP, check out the following demos and samples:\r\n\u2022<a href=\"https://github.com/Unity-Technologies/FontainebleauDemo\">Fontainebleau Demo</a>\r\n\u2022<a href=\"https://github.com/Unity-Technologies/SpaceshipDemo\">Spaceship Demo</a>\r\n\u2022<a href=\"https://github.com/Unity-Technologies/SmallOfficeRayTracing\">Raytracing Demo</a>\r\n\u2022<a href=\"https://github.com/Unity-Technologies/VRAlchemyLab\">VR Demo</a>\r\n\u2022<a href=\"https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@latest/index.html?subfolder=/manual/HDRP-Sample-Content.html\">Sample Content</a>\r\n\r\nFinally, you can watch the full <a href=\"https://www.youtube.com/watch?v=yqCHiZrgKzs\">Unite Now 2020</a> presentation to get a more in-depth overview of HDRP's capabilities."
