--- !u!114 &-7466114129244489197
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Let's take a look at the Butterflies VFX.\n\n1. In the <i>Hierarchy,</i> select <b>VFX</b> > <b>Butterflies.</b>\n\n2. In its <i>Inspector,</i> set the <b>Wing Animation Speed</b> to 0.1. \n\nNotice how the animation slows down."
--- !u!114 &-6850416536898747869
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this tutorial, you learned how dust and butterflies were added into the project using the VFX graph.\r\n\r\nFor more information, check out the <a href=\"https://docs.unity3d.com/Packages/com.unity.visualeffectgraph@6.9/manual/index.html\">documentation</a> and additional <a href=\"https://github.com/Unity-Technologies/VisualEffectGraph-Samples\">VFX samples.</a>\r\n\r\n<b>Note:</b> You do not need to save your changes in order to follow other tutorials.\r"
