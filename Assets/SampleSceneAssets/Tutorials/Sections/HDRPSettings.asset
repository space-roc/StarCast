  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'Let''s see how the High Definition Render Pipeline has been enabled for this project.


      1. Go to <b>Edit</b> > <b>Project Settings</b> > <b>Graphics.</b>


      2. At the very top, you can see that an <i>HD Render Pipeline Asset</i> has been assigned to the <i>Scriptable Render Pipeline Settings.</i>'
