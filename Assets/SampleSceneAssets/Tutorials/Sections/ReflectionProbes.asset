--- !u!114 &-6150537372107395094
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You can enable the  <b>Use Influence Volume as a Proxy Volume</b> checkbox to ensure that a reflection map captured by a Reflection Probe is warped based on the camera position and the shape of the Reflection Probe. This will provide a better approximation of the reflections and attempt to ground them with the surroundings.\r\n\r\n1. In the <i>Hierarchy,</i> under <b>Lighting</b> > <b>Reflection Probes</b> > <b>Room 3,</b> select <b>ReflectionProbe Room 3 Ceiling.</b>\r\n\r\n2. In the <i>Inspector,</i> toggle the <b>Use Influence Volume as a Proxy Volume</b> checkbox.\r\n\r\nWith the checkbox enabled, the reflective surfaces can receive more accurate reflections.\r"
