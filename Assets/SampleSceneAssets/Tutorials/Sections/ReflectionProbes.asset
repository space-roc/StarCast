--- !u!114 &2501994879575251002
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'A complex room like the second room which has curved walls, a sloped ceiling, and a wide range of lighting intensities, requires a large number of <b>Reflection Probes</b> to reach a high reflection quality.


      The size of <b>Reflection Probes</b> directly influences how they are sorted and blended with each other: smaller Reflection Probes tend to have more influence on nearby objects than larger ones.'
