  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'Materials are used to set the visual aspect of the objects in the Scene. Typically, a Material relies on a shader and a variety of imputs, such as textures and numerical values.


      HDRP uses <b>Physically Based Rendering (PBR)</b> materials. PBR is an industry-standard technique that more accurately simulates the real-world interaction of the lighting with the materials.'
